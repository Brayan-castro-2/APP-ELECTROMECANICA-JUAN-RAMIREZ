# ============================================
# IMPRESORA TÉRMICA BLUETOOTH (JP80H)
# ============================================
# Puerto COM que Windows asigna cuando emparejás la impresora JP80H por Bluetooth.
# Para encontrarlo: Panel de Control → Dispositivos e impresoras → clic derecho JP80H → Propiedades → Servicios
# Buscar el puerto "Saliente" / "Outgoing". Ejemplos: COM3, COM4, COM5...
# Este valor solo tiene efecto cuando el servidor Node.js corre LOCALMENTE (npm run dev).
PRINTER_COM_PORT=COM3
